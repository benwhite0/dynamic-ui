# Get your Google Gemini API Key here https://cloud.google.com/vertex-ai
GOOGLE_GENERATIVE_AI_API_KEY=****

# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

/*
 * The following keys below are automatically created and
 * added to your environment when you deploy on vercel
 */

# Instructions to create kv database here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****

# Optional: company MCP server. When set, its tools are offered to the LLM
# alongside the local ones. URLs ending in /sse use SSE transport, otherwise
# Streamable HTTP. e.g. https://ux.cortexreply.ai/api/mcp
MCP_SERVER_URL=
# Bearer token for the MCP server (e.g. MCP_API_KEY from 1Password/Teams)
MCP_API_KEY=

/*
 * AI spend reports (/reports). Where the report data is read from.
 */

# "athena" queries the FOCUS 1.5 view below; "csv" reads the committed dummy
# fixture at data/ai-spend.csv, which needs no AWS access and is the quickest
# way to check the charts still render. Defaults to "csv" when unset.
REPORTS_SOURCE=athena

# Credentials come from the standard AWS provider chain. Locally that means an
# SSO profile (`aws sso login --profile <name>`, then AWS_PROFILE below); when
# deployed, prefer an execution role over static keys.
AWS_REGION=eu-west-1
AWS_PROFILE=

# Athena catalogue database holding the spend view, and the view itself.
# The view must expose the FOCUS columns ChargePeriodStart, ResourceId,
# SkuMeter, ConsumedQuantity, ConsumedUnit, ChargeCategory, BilledCost and Tags.
ATHENA_DATABASE=finops
ATHENA_SPEND_VIEW=finops.focus_1_4_cost_and_usage

# Workgroup to bill and run the query under.
ATHENA_WORKGROUP=primary

# S3 URI for query results, e.g. s3://my-athena-results/reports/. Optional —
# leave blank if the workgroup already enforces an output location.
ATHENA_OUTPUT_LOCATION=

# FOCUS Tags keys backing the team and project dimensions. Leave blank while no
# cost allocation tags are activated — both dimensions then report "untagged".
# Set them once the tags exist and the dimensions populate with no code change.
ATHENA_TEAM_TAG_KEY=
ATHENA_PROJECT_TAG_KEY=

# How long the date bounds and dimension vocabulary are cached. These are read
# on every chat message to build the prompt, and change at most daily, so this
# is the difference between one Athena query per message and one per 15 min.
REPORTS_CACHE_TTL_SECONDS=900
